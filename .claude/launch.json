{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backlot",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "backlot", "serve", "--port", "4750"],
      "port": 4750
    },
    {
      "name": "mockups",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4788", "--bind", "127.0.0.1"],
      "port": 4788
    },
    {
      "name": "capclip-api",
      "runtimeExecutable": "capclip/server/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "capclip.api:app", "--app-dir", "capclip/server", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "capclip-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "capclip/web", "run", "dev"],
      "port": 3000
    }
  ]
}
